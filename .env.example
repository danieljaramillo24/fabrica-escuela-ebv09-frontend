# Plantilla de variables de entorno. Copiar a `.env` (NO se versiona; ver .gitignore).
# Todo lo que empiece con VITE_ queda visible en el navegador: nunca poner secretos aqui.

# URL base del backend en despliegue (Vercel). Sin barra final.
# En desarrollo dejarla VACIA: las llamadas van a /api y Vite las reenvia al backend (ver vite.config.ts).
VITE_API_BASE_URL=

# Solo desarrollo: a donde reenvia Vite las llamadas /api. Por defecto http://localhost:8080
# VITE_PROXY_TARGET=http://localhost:8080
