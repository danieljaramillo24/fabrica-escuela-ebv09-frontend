# Plantilla de variables de entorno. Copiar a `.env` (NO se versiona; ver .gitignore).
# Todo lo que empiece con VITE_ queda visible en el navegador: nunca poner secretos aqui.

# URL base del backend en despliegue (Render). Sin barra final.
# En desarrollo dejarla VACIA: las llamadas van a /api y Vite las reenvia al backend (ver vite.config.ts).
VITE_API_BASE_URL=

# Solo desarrollo: "true" usa datos simulados en memoria (sesion, especialidades, horarios y citas)
# para ver las pantallas sin backend. Cualquier contrasena sirve; el rol sale del correo:
# "especialista@..." -> especialista, "admin@..." -> administrador, cualquier otro -> usuario.
# En produccion se ignora.
# VITE_MODO_SIMULADO=true

# Solo desarrollo: a donde reenvia Vite las llamadas /api. Por defecto http://localhost:8080
# VITE_PROXY_TARGET=http://localhost:8080
